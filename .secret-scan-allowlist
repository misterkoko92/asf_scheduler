# Regex allowlist for tools/scan_secrets.py
# Each non-empty, non-comment line is treated as a regular expression
# matched against: "<relative_path>:<line_no>:<line_content>"
#
# Example:
# ^tests/fixtures/demo\.txt:\d+:token\s*=\s*dummy_demo_token_value$

# Test fixtures for secret scanner itself (intentional synthetic tokens).
^tests/test_tools_quality_security\.py:\d+:.+ghp_[A-Za-z0-9_]{30,}.+$
^tests/test_tools_quality_security\.py:\d+:.+Bearer [A-Za-z0-9\-_]{20,}.+$
^tests/test_tools_quality_security\.py:\d+:.+token=abcdabcdabcdabcd.*$
