# Air France API
AF_API_KEY=replace_with_your_key
AF_MAX_CALLS_PER_DAY=100
AF_MIN_DELAY_SECONDS=1.1
# S=Scheduled, M=Modified, I=Internal, P=Public
AF_TIME_ORIGIN_TYPE=P

# Optional OneDrive root override (local mode)
# ASF_ONEDRIVE_ROOT=/Users/yourname/Library/CloudStorage/OneDrive-YourOrg

# Optional solver tuning (hours)
# Default values are 3.0 and preserve current behavior.
# ASF_DUREE_MISSION_HEURES=3
# ASF_MIN_HOURS_BETWEEN_FLIGHTS=3
